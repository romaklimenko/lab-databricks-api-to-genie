# Authenticate with the Databricks CLI. Do not put tokens in this file.
DATABRICKS_CONFIG_PROFILE=playground
WEATHER_MODEL=system.ai.claude-sonnet-4-5
# local creates artifacts and loads SQLite. cloud runs the Databricks job and Genie.
WEATHER_TARGET=local
WEATHER_CATALOG=your_test_catalog
WEATHER_SCHEMA=weather_agents_lab
WEATHER_WAREHOUSE_ID=
# Required for deployed cloud runs: a volume created by `weather-lab setup`.
WEATHER_STATE_VOLUME=
# Optional for local runs. Required for cloud publication: owner/repository.
WEATHER_GITHUB_REPO=
# Supply GITHUB_TOKEN through a secret resource on Apps, never through committed files.
# Locally, Git publication can use the authenticated gh CLI.
WEATHER_RUNS_DIR=.runs
WEATHER_JOB_ENVIRONMENT=4
